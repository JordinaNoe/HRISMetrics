# Postgres connection string. Locally: docker compose up -d, then use the
# values from docker-compose.yml. In production: your managed Postgres URL
# (Neon, Supabase, Azure Database for PostgreSQL, RDS, etc).
DATABASE_URL="postgresql://hrismetrics:hrismetrics@localhost:5432/hrismetrics?schema=public"

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Microsoft Entra ID (Azure AD) SSO ---
# Register an app at https://portal.azure.com > Microsoft Entra ID > App registrations.
#   - Redirect URI (Web): https://<your-domain>/api/auth/callback/microsoft-entra-id
#     (for local dev: http://localhost:3000/api/auth/callback/microsoft-entra-id)
#   - Create a client secret under "Certificates & secrets".
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Restricts sign-in to your tenant only (recommended). Find your Directory
# (tenant) ID on the app registration's Overview page.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Extra guard: only allow sign-in for emails on this domain (in addition to
# the tenant restriction above). Leave unset to allow any tenant account.
ALLOWED_EMAIL_DOMAIN=rakuten.com

# Comma-separated list of emails who can manage category access (Admin page)
# and enter data for every category, regardless of CategoryAccess rows.
ADMIN_EMAILS=jordina.noe@rakuten.com

# Local-only escape hatch: adds a "Dev login" box on the sign-in page that
# accepts any typed email, no Azure AD app registration required. NEVER set
# this to true outside your own machine.
ALLOW_DEV_LOGIN=false
